# Copy to .env and edit. Never commit .env.

# Which AWS profile (from ~/.aws on this machine) pays for the tokens.
AWS_PROFILE=default
# Region for Bedrock Runtime calls (Grok, Claude).
AWS_REGION=us-east-1
# Region for Bedrock Mantle (OpenAI models): us-east-1, us-east-2 or us-west-2.
MANTLE_REGION=us-east-1

# The key clients send to the gateway. Any string starting with sk-.
LITELLM_MASTER_KEY=sk-change-me
# Shared secret between LiteLLM and the translator.
TRANSLATOR_API_KEY=change-me-too

# Optional: a long-term Bedrock API key for Mantle, instead of the AWS profile.
# MANTLE_API_KEY=

# Translator behaviour (defaults shown).
# UPSTREAM_API=responses     # "chat" relays Chat Completions to Mantle untranslated
# CARRY_REASONING=1          # 0 stops re-attaching reasoning items between tool calls

# Host ports.
GATEWAY_PORT=4000
CATALOG_PORT=8090
